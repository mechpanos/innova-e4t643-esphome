# Copy to secrets.yaml (which is git-ignored) and fill in your own values.
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"

# 32-byte base64 key for the native API. Generate one, for example:
#   openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_YOUR_OWN_BASE64_KEY"

ota_password: "choose-an-ota-password"
